{%- comment -%}
  Tante Rie – Product + BreadcrumbList structured data (fallback)
  Rendered from layout/theme.liquid on product and collection pages.

  SEO-audit 2026-09-25: elk product-template krijgt precies één volledig
  Product-schema (tr-product-schema.liquid, of het inline blok in product-cro).
  - bakmix/blond/bunzlau/rice/joeff/waterfles: de sectie rendert het zelf.
  - standaard/thee/accessoires: wordt hieronder vanuit de layout gerenderd.
  De eenvoudige fallback hieronder geldt alleen nog voor onbekende templates.
{%- endcomment -%}

{%- assign has_own_product_schema = false -%}
{%- assign has_own_breadcrumb_schema = false -%}
{%- assign section_schema_suffixes = ',bakmix,blond,bunzlau,rice,joeff,waterfles,' -%}
{%- assign layout_schema_suffixes = ',thee,accessoires,' -%}
{%- assign suffix_key = ',' | append: template.suffix | append: ',' -%}
{%- if template.name == 'product' -%}
  {%- if section_schema_suffixes contains suffix_key -%}
    {%- comment -%} Sectie rendert zelf tr-product-schema {%- endcomment -%}
    {%- assign has_own_product_schema = true -%}
    {%- assign has_own_breadcrumb_schema = true -%}
  {%- elsif template.suffix == blank or layout_schema_suffixes contains suffix_key -%}
    {%- comment -%} tr-product-redesign / tr-accessoires-redesign: volledig schema vanuit hier {%- endcomment -%}
    {%- render 'tr-product-schema', product: product -%}
    {%- assign has_own_product_schema = true -%}
    {%- assign has_own_breadcrumb_schema = true -%}
  {%- elsif template.suffix == 'cro' -%}
    {%- comment -%} product-cro heeft een eigen Product-blok, maar geen breadcrumb {%- endcomment -%}
    {%- assign has_own_product_schema = true -%}
  {%- endif -%}
{%- endif -%}

{%- if template.name == 'product' -%}
  {%- assign product_url = shop.url | append: product.url -%}
{%- endif -%}

{%- if template.name == 'product' and has_own_product_schema == false -%}
  {%- assign jm_rating_mf = product.metafields.reviews.rating -%}
  {%- assign jm_count_raw = product.metafields.reviews.rating_count.value | plus: 0 -%}
  {%- assign has_ratings = false -%}
  {%- if jm_rating_mf and jm_count_raw > 0 -%}{%- assign has_ratings = true -%}{%- endif -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
    "url": {{ product_url | json }},
    {%- if product.featured_image -%}
    "image": {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        {%- if variant.sku != blank -%}
        "sku": {{ variant.sku | json }},
        {%- endif -%}
        "price": {{ variant.price | times: 0.01 }},
        "priceCurrency": "EUR",
        "availability": {%- if variant.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
        "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
        "seller": {
          "@type": "Organization",
          "name": "Tante Rie"
        }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
    {%- if has_ratings -%}
    ,"aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ jm_rating_mf.value.rating | default: jm_rating_mf.value | round: 1 }}",
      "reviewCount": "{{ jm_count_raw }}",
      "bestRating": "{{ jm_rating_mf.value.scale_max | default: 5 }}",
      "worstRating": "{{ jm_rating_mf.value.scale_min | default: 1 }}"
    }
    {%- endif -%}
  }
  </script>
{%- endif -%}

{%- assign show_breadcrumb_schema = false -%}
{%- if template.name == 'collection' -%}
  {%- assign show_breadcrumb_schema = true -%}
{%- elsif template.name == 'product' and has_own_breadcrumb_schema == false -%}
  {%- assign show_breadcrumb_schema = true -%}
{%- endif -%}

{%- if show_breadcrumb_schema -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      }
      {%- if collection -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
      {%- if template.name == 'product' -%}
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ product_url | json }}
      }
      {%- endif -%}
      {%- elsif template.name == 'product' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ product_url | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}
