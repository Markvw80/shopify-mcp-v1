<script>
(function () {
  var usp, bar, rafId;

  function updateFilterTop() {
    usp = usp || document.querySelector('.trbz-usp-bar');
    bar = bar || document.querySelector('.trbz-filter-toolbar');
    if (!usp || !bar) return;
    var bottom = usp.getBoundingClientRect().bottom;
    // Alleen updaten als USP sticky is (boven in viewport)
    if (bottom > 0 && bottom < window.innerHeight * 0.5) {
      bar.style.top = bottom + 'px';
    }
  }

  function onScroll() {
    if (rafId) return;
    rafId = requestAnimationFrame(function () { rafId = null; updateFilterTop(); });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateFilterTop);
  window.addEventListener('load', updateFilterTop);
  updateFilterTop();
})();
</script>

<script>
(function () {
  var form   = document.getElementById('trbz-filter-form');
  var overlay = document.getElementById('trbz-filter-overlay');
  if (!form) return;

  var pills     = form.querySelectorAll('[data-trbz-pill]');
  var dropdowns = form.querySelectorAll('[data-trbz-dropdown]');

  function closeAll() {
    pills.forEach(function (p) { p.setAttribute('aria-expanded', 'false'); });
    dropdowns.forEach(function (d) { d.classList.remove('open'); });
    if (overlay) overlay.classList.remove('open');
  }

  pills.forEach(function (pill, i) {
    pill.addEventListener('click', function () {
      var isOpen = pill.getAttribute('aria-expanded') === 'true';
      closeAll();
      if (!isOpen) {
        pill.setAttribute('aria-expanded', 'true');
        dropdowns[i].classList.add('open');
        if (overlay) overlay.classList.add('open');
      }
    });
  });

  if (overlay) overlay.addEventListener('click', closeAll);

  form.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
    cb.addEventListener('change', function () { form.submit(); });
  });

  var sortSel = form.querySelector('[data-trbz-sort]');
  if (sortSel) {
    sortSel.addEventListener('change', function () {
      var hidden = form.querySelector('input[name="sort_by"]');
      if (hidden) hidden.remove();
      form.submit();
    });
  }
})();
</script>

