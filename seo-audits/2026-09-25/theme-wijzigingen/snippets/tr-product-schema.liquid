{%- doc -%}
  Emits JSON-LD structured data voor een product-pagina: BreadcrumbList + Product.
  Bevat altijd: name, description, image, sku, brand, offers (price, currency, availability,
  shippingDetails, hasMerchantReturnPolicy). aggregateRating wordt toegevoegd als reviews
  metafields zijn ingevuld (Judge.me / Shopify standard).

  Retourbeleid:
  - Thee-templates / "thee" in product.type → NotPermitted (voedingsmiddel, wettelijk geen retour)
  - Andere producten → 14 dagen MerchantReturnFiniteReturnWindow (Dutch consumer law)

  Verzending:
  - €4,50 flat tarief binnen NL, 1 werkdag handling, 1-3 dagen transit.
  - pickup_only: true (of template bunzlau/blond) → geen verzending (alleen afhalen in de winkel in Borne);
    shippingDetails krijgt dan doesNotShip en retour gaat via de winkel.

  @param {object} product - Het product om te beschrijven.
  @param {string} [brand_name] - Override voor brand.name, standaard product.vendor.
  @param {boolean} [pickup_only] - Product wordt niet verzonden, alleen afgehaald.

  @example
    {%- render 'tr-product-schema', product: product -%}
    {%- render 'tr-product-schema', product: product, brand_name: 'Blond Amsterdam', pickup_only: true -%}
{%- enddoc -%}

{%- comment %} Detect thee vs accessoires voor retourbeleid {%- endcomment -%}
{%- assign is_thee = false -%}
{%- if template.suffix == 'thee' -%}
  {%- assign is_thee = true -%}
{%- elsif product.type != blank -%}
  {%- assign type_lower = product.type | downcase -%}
  {%- if type_lower contains 'thee' -%}{%- assign is_thee = true -%}{%- endif -%}
{%- endif -%}

{%- comment %} Bunzlau- en Blond-templates: alleen afhalen in Borne {%- endcomment -%}
{%- if template.suffix == 'bunzlau' or template.suffix == 'blond' -%}{%- assign pickup_only = true -%}{%- endif -%}

{%- assign breadcrumb_collection = product.collections | first -%}
{%- assign avail = 'https://schema.org/OutOfStock' -%}
{%- if product.available -%}{%- assign avail = 'https://schema.org/InStock' -%}{%- endif -%}
{%- assign first_variant = product.selected_or_first_available_variant -%}

{%- comment %} Reviews metafields (Judge.me / Shopify standard) {%- endcomment -%}
{%- assign jm_rating_mf = product.metafields.reviews.rating -%}
{%- assign jm_count_raw = product.metafields.reviews.rating_count.value | plus: 0 -%}
{%- assign has_ratings = false -%}
{%- if jm_rating_mf and jm_count_raw > 0 -%}{%- assign has_ratings = true -%}{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ request.origin }}/"
    }{%- if breadcrumb_collection -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ breadcrumb_collection.title | json }},
      "item": "{{ request.origin }}{{ breadcrumb_collection.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": "{{ request.origin }}{{ product.url }}"
    }
    {%- else -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": "{{ request.origin }}{{ product.url }}"
    }
    {%- endif -%}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ request.origin }}{{ product.url }}",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | json }},
  "url": "{{ request.origin }}{{ product.url }}",
  "image": [
    {%- for img in product.images limit: 5 -%}
      "{{ img | image_url: width: 1200 | prepend: 'https:' }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- if first_variant.sku != blank -%}
  "sku": {{ first_variant.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ brand_name | default: product.vendor | default: shop.name | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ request.origin }}{{ product.url }}",
    "price": "{{ product.price | divided_by: 100.0 }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "{{ avail }}",
    "itemCondition": "https://schema.org/NewCondition",
    {%- if pickup_only -%}
    "availableDeliveryMethod": "https://schema.org/OnSitePickup",
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "doesNotShip": true,
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "NL"
      }
    },
    {%- else -%}
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "4.50",
        "currency": "EUR"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "NL"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 3,
          "unitCode": "DAY"
        }
      }
    },
    {%- endif -%}
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "NL",
      {%- if is_thee -%}
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
      {%- else -%}
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 14,
      {%- if pickup_only -%}
      "returnMethod": "https://schema.org/ReturnInStore",
      "returnFees": "https://schema.org/FreeReturn"
      {%- else -%}
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/ReturnShippingFees"
      {%- endif -%}
      {%- endif -%}
    }
  }{%- if has_ratings -%},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ jm_rating_mf.value.rating | default: jm_rating_mf.value | round: 1 }}",
    "reviewCount": "{{ jm_count_raw }}",
    "bestRating": "{{ jm_rating_mf.value.scale_max | default: 5 }}",
    "worstRating": "{{ jm_rating_mf.value.scale_min | default: 1 }}"
  }
  {%- endif -%}
}
</script>
